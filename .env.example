# Copy this file to .env and fill in your values. Never commit .env.
# Values in .env override anything already set in your shell.

# Which LLM to use: "groq" or "gemini". If left out, Groq is used when GROQ_API_KEY is set, otherwise Gemini.
LLM_PROVIDER=groq

# Groq (free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: after the first run has downloaded the embedding model, set this to
# skip Hugging Face network checks (faster startup, works offline).
# HF_HUB_OFFLINE=1

# /grade safeguards (see README)
MIN_RUBRIC_SIMILARITY=0.35
MAX_SCORE_DISAGREEMENT=1
