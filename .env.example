# Copy this file to .env and fill in your values. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: after the first run has downloaded the embedding model, set this to
# skip Hugging Face network checks (faster startup, works offline).
# HF_HUB_OFFLINE=1
